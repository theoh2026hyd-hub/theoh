# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
install.log

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large video files (served via Cloudinary CDN)
public/*.mp4
public/*.mov
public/*.webm

# scratch/debug scripts
scratch_test.js
test_*.js
fix_*.js
seed_*.js
find_*.js
get_*.js
lookup_*.js
resolve_*.js

# database migration dumps & user data
migration_dump/
*.dump
users_migration.json
